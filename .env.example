# ============ LLM providers ============
OPENROUTER_API_KEY=
HF_TOKEN=

# Pinned model snapshots (НЕ "latest" — для reproducibility manifest)
# Подробности и дата pinning — в notes/llm_models.md
OPENROUTER_MODEL_FAST=qwen/qwen3-32b-instruct-2507
OPENROUTER_MODEL_DEEP=qwen/qwen3-235b-a22b-thinking-2507
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-chat-v3.1

# ============ Telegram parser ============
# Получить на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=moex_bot_parser

# ============ Data sources ============
ALGOPACK_API_KEY=

# ============ Broker (paper trading до 13 мая) ============
TINVEST_SANDBOX_TOKEN=

# ============ Broker (hackathon, появится 13 мая) ============
ALPHA_SANDBOX_TOKEN=
ALPHA_SANDBOX_URL=

# ============ Infrastructure ============
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
REDIS_URL=redis://redis:6379/0

# ============ Langfuse (observability) ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ============ Alerting ============
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ============ Runtime ============
ENV=dev
LOG_LEVEL=INFO
